{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-core:heal-proposal:1",
  "title": "qa-core-flaky triage.json healProposal, Version 1",
  "description": "What qa-core-flaky stores in the reserved healProposal field of a triage entry. null means heal was not asked. Additive under triage schemaVersion 1.",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tool",
    "toolVersion",
    "mode",
    "status",
    "strategy",
    "reviewLevel",
    "label"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "tool": {
      "const": "qa-core-heal"
    },
    "toolVersion": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "dry-run",
        "apply"
      ],
      "description": "Flaky only ever asks for dry-run. apply is shown only if a person applied by hand and results were merged later."
    },
    "status": {
      "enum": [
        "proposed",
        "applied",
        "refused",
        "not-locator",
        "nothing-to-heal",
        "error",
        "unavailable",
        "skipped-by-gate"
      ]
    },
    "strategy": {
      "enum": [
        "locator-heal",
        "rule-suggestion",
        "ai-suggestion",
        "none"
      ]
    },
    "fixRuleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewLevel": {
      "enum": [
        "standard",
        "review-carefully"
      ]
    },
    "label": {
      "type": "string",
      "description": "Fixed text shown above the proposal, for example: Proposal from qa-core-heal (dry run, not applied)."
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "urn:qa-core:heal-results:1#/$defs/change"
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 600
    },
    "refusal": {
      "type": [
        "object",
        "null"
      ]
    },
    "verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "ai": {
      "type": [
        "object",
        "null"
      ]
    },
    "applyCommand": {
      "type": [
        "string",
        "null"
      ],
      "description": "The exact command a person can run to apply by hand. Never run by flaky."
    }
  }
}
