{
  "name": "qa-core-flaky",
  "version": "0.0.1",
  "description": "Normalize Playwright JSON and JUnit reports so flaky tests can be triaged.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qa-core-flaky": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "demo:live": "playwright test --config demo/saucedemo/playwright.config.ts",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:triage": "node dist/cli.js triage demo/saucedemo/reports/recorded-seed-443.json --fail-on never",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:html": "npm run build && playwright test --config playwright.html.config.ts",
    "example:screenshots": "npm run build && node scripts/example-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^22",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "1.60.0",
    "typescript": "^5.6"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
