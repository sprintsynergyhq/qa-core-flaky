{
  "name": "qa-core-flaky",
  "version": "0.1.2",
  "description": "Triage flaky Playwright tests: real bug or flaky, likely cause, and a suggested fix to review.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "SprintSynergy",
    "url": "https://sprintsynergy.com"
  },
  "contributors": [
    {
      "name": "Muhammad Usman",
      "url": "https://linkedin.com/in/sdet-muhammadusman"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprintsynergyhq/qa-core-flaky.git"
  },
  "homepage": "https://github.com/sprintsynergyhq/qa-core-flaky#readme",
  "bugs": {
    "url": "https://github.com/sprintsynergyhq/qa-core-flaky/issues"
  },
  "keywords": [
    "playwright",
    "flaky-tests",
    "test-triage",
    "qa",
    "ci",
    "test-automation"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qa-core-flaky": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "demo:live": "playwright test --config demo/saucedemo/playwright.config.ts",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:triage": "node dist/cli.js triage demo/saucedemo/reports/recorded-seed-443.json --fail-on never",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:html": "npm run build && playwright test --config playwright.html.config.ts",
    "example:screenshots": "npm run build && node scripts/example-screenshots.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.60.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^22",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "1.60.0",
    "typescript": "^5.6"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
