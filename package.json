{
  "name": "qa-core-flaky",
  "version": "0.0.1",
  "description": "Normalize Playwright JSON reports so flaky tests can be triaged.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qa-core-flaky": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6",
    "@types/node": "^22",
    "@playwright/test": "1.60.0",
    "playwright": "1.60.0"
  }
}
